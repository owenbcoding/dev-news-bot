# Copy to .env and fill in. In Portainer/Docker, set these as environment variables instead.

# Required
DISCORD_TOKEN=your_discord_bot_token_here
CHANNEL_ID=your_discord_channel_id_here

# Optional
DEV_CHANNEL_ID=
# Posts run automatically at 09:00 UTC and 17:00 UTC
ARCHIVE_PATH=data/dev_news_archive.jsonl
DEDUPE_INDEX_PATH=data/dev_news_dedupe.json
MAX_POSTS_PER_RUN=8
MAX_PER_SOURCE=2
SEND_TEXT_DIGEST=false
